[Unit]
Description=Jadwal Waktu Salat (JWS) SDL2 Kiosk Application
After=systemd-user-sessions.service plymouth-start.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=jws
Group=jws
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal+console
StandardError=journal+console
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=XDG_RUNTIME_DIR=/run/user/1000

# Lepaskan DRM master Plymouth sebelum aplikasi mulai, pertahankan tampilan frame terakhir
ExecStartPre=+/usr/bin/plymouth quit --retain-splash

ExecStart=/usr/local/bin/jws-app
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target multi-user.target
