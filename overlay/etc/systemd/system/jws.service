[Unit]
Description=Jadwal Waktu Salat (JWS) SDL2 Kiosk Application
After=systemd-user-sessions.service plymouth-start.service splash-apply.service systemd-udev-trigger.service
Conflicts=getty@tty1.service

[Service]
Type=simple
Nice=-10
User=root
Group=root
SupplementaryGroups=video render input audio tty dialout
StandardOutput=journal
StandardError=journal
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SDL_AUDIODRIVER=dummy
Environment=XDG_RUNTIME_DIR=/tmp

ExecStartPre=+/bin/sh -c 'chmod -R 666 /dev/dri/* /dev/fb* /dev/input/* /dev/tty1 /dev/gpiochip* 2>/dev/null || true; /usr/bin/plymouth quit 2>/dev/null || true'
ExecStart=/usr/local/bin/jws-app
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target multi-user.target
