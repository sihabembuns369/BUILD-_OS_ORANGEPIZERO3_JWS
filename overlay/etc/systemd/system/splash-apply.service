[Unit]
Description=Terapkan Konfigurasi Splash Screen Plymouth
DefaultDependencies=no
RequiresMountsFor=/boot
After=local-fs.target
Before=plymouth-start.service sysinit.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/splash-apply
RemainAfterExit=yes
TimeoutSec=30

[Install]
WantedBy=sysinit.target
