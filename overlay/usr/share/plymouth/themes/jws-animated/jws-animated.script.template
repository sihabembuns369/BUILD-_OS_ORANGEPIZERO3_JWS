// Background color
Window.SetBackgroundTopColor(bg_r, bg_g, bg_b);
Window.SetBackgroundBottomColor(bg_r, bg_g, bg_b);

// Sprite utama container
screen_sprite = Sprite();

if (mode == "image") {
    raw_img = Image("splash.png");
    if (!raw_img) {
        raw_img = Image("default_logo.png");
    }

    if (raw_img) {
        screen_sprite.SetImage(raw_img);
        screen_sprite.SetOpacity(1);
    }

    fun refresh_callback () {
        w = Window.GetWidth();
        h = Window.GetHeight();
        if (!w || w <= 0) w = 1280;
        if (!h || h <= 0) h = 720;
        x = Window.GetX();
        y = Window.GetY();
        if (!x) x = 0;
        if (!y) y = 0;

        if (raw_img) {
            iw = raw_img.GetWidth();
            ih = raw_img.GetHeight();
            pos_x = x + (w - iw) / 2;
            pos_y = y + (h - ih) / 2 - 30;
            if (position_mode == "top") {
                pos_y = y + h * 0.15;
            } else if (position_mode == "bottom") {
                pos_y = y + h * 0.7 - ih;
            }
            screen_sprite.SetPosition(pos_x, pos_y, 10);
            screen_sprite.SetOpacity(1);
        }
    }

    refresh_callback();
    Plymouth.SetRefreshFunction(refresh_callback);

} else {
    // Mode Animation / Frames / GIF
    // Plymouth Image() secara otomatis meresolusi path relatif terhadap ImageDir
    for (i = 1; i <= frame_count; i++) {
        idx_str = "";
        if (i < 10) idx_str = "00" + i;
        else if (i < 100) idx_str = "0" + i;
        else idx_str = "" + i;

        frames[i] = Image("frame_" + idx_str + ".png");
    }

    current_frame = 1;
    frame_timer = 0;
    anim_finished = 0;

    fun refresh_callback () {
        w = Window.GetWidth();
        h = Window.GetHeight();
        if (!w || w <= 0) w = 1280;
        if (!h || h <= 0) h = 720;
        x = Window.GetX();
        y = Window.GetY();
        if (!x) x = 0;
        if (!y) y = 0;

        if (anim_finished == 0 && frame_count > 1) {
            frame_timer++;
            ticks_per_frame = 50 / target_fps;
            if (ticks_per_frame < 1) ticks_per_frame = 1;

            if (frame_timer >= ticks_per_frame) {
                frame_timer = 0;
                current_frame++;
                if (current_frame > frame_count) {
                    if (loop_mode == 1) {
                        current_frame = 1;
                    } else {
                        current_frame = frame_count;
                        anim_finished = 1;
                    }
                }
            }
        }

        img = frames[current_frame];
        if (!img && frames[1]) {
            img = frames[1];
        }

        if (img) {
            iw = img.GetWidth();
            ih = img.GetHeight();
            pos_x = x + (w - iw) / 2;
            pos_y = y + (h - ih) / 2 - 30;
            if (position_mode == "top") {
                pos_y = y + h * 0.15;
            } else if (position_mode == "bottom") {
                pos_y = y + h * 0.7 - ih;
            }
            screen_sprite.SetImage(img);
            screen_sprite.SetPosition(pos_x, pos_y, 10);
            screen_sprite.SetOpacity(1);
        }
    }

    refresh_callback();
    Plymouth.SetRefreshFunction(refresh_callback);
}

// Text rendering
if (text_msg != "") {
    text_image = Image.Text(text_msg, text_r, text_g, text_b, 1, "Sans 16");
    if (text_image) {
        text_sprite = Sprite(text_image);
        fun message_refresh() {
            w = Window.GetWidth();
            h = Window.GetHeight();
            if (!w || w <= 0) w = 1280;
            if (!h || h <= 0) h = 720;
            x = Window.GetX();
            y = Window.GetY();
            if (!x) x = 0;
            if (!y) y = 0;
            tx = x + (w - text_image.GetWidth()) / 2;
            ty = y + h * 0.85;
            text_sprite.SetPosition(tx, ty, 20);
            text_sprite.SetOpacity(1);
        }
        message_refresh();
    }
}
