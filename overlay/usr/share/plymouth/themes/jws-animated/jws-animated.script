// jws-animated.script - Dibuat otomatis untuk Orange Pi Zero 3 JWS
mode = "gif";
bg_r = 0.000;
bg_g = 0.000;
bg_b = 0.000;
scale_mode = "fit";
position_mode = "center";
frame_count = 24;
target_fps = 15;
loop_mode = 1;
text_msg = "Memuat jadwal salat...";
text_r = 1.000;
text_g = 1.000;
text_b = 1.000;

// Background color
Window.SetBackgroundTopColor(bg_r, bg_g, bg_b);
Window.SetBackgroundBottomColor(bg_r, bg_g, bg_b);

// Sprite utama container animasi
global.screen_sprite = Sprite();

global.current_frame = 1;
global.frame_timer = 0;
global.anim_dim = 320;
global.anim_pos_y = 150;

if (mode == "image") {
    global.raw_img = Image("splash.png");
    if (!global.raw_img) {
        global.raw_img = Image("default_logo.png");
    }

    if (global.raw_img) {
        global.screen_sprite.SetImage(global.raw_img);
        global.screen_sprite.SetOpacity(1);
    }

    fun refresh_callback () {
        w = Window.GetWidth();
        h = Window.GetHeight();
        if (!w || w <= 0) w = 1280;
        if (!h || h <= 0) h = 720;
        x = Window.GetX();
        y = Window.GetY();
        if (!x) x = 0;
        if (!y) y = 0;

        if (global.raw_img) {
            iw = global.raw_img.GetWidth();
            ih = global.raw_img.GetHeight();
            pos_x = x + (w - iw) / 2;
            pos_y = y + (h - ih) / 2 - 40;
            if (position_mode == "top") {
                pos_y = y + h * 0.15;
            } else if (position_mode == "bottom") {
                pos_y = y + h * 0.7 - ih;
            }
            global.anim_pos_y = pos_y;
            global.anim_dim = ih;
            global.screen_sprite.SetPosition(pos_x, pos_y, 10);
            global.screen_sprite.SetOpacity(1);
        }
    }

    refresh_callback();
    Plymouth.SetRefreshFunction(refresh_callback);

} else {
    // Mode Animation / Frames / GIF
    // Muat seluruh frame langsung di global scope
    for (i = 1; i <= frame_count; i++) {
        idx_str = "";
        if (i < 10) idx_str = "00" + i;
        else if (i < 100) idx_str = "0" + i;
        else idx_str = "" + i;

        global.frames[i] = Image("frame_" + idx_str + ".png");
    }

    if (global.frames[1]) {
        global.screen_sprite.SetImage(global.frames[1]);
        global.screen_sprite.SetOpacity(1);
    }

    fun refresh_callback () {
        w = Window.GetWidth();
        h = Window.GetHeight();
        if (!w || w <= 0) w = 1280;
        if (!h || h <= 0) h = 720;
        x = Window.GetX();
        y = Window.GetY();
        if (!x) x = 0;
        if (!y) y = 0;

        // Hitung frame rate (refresh interval Plymouth = 50Hz)
        ticks_per_frame = 50 / target_fps;
        if (ticks_per_frame < 1) ticks_per_frame = 1;

        global.frame_timer++;
        if (global.frame_timer >= ticks_per_frame) {
            global.frame_timer = 0;
            global.current_frame++;
            if (global.current_frame > frame_count) {
                if (loop_mode == 1) {
                    global.current_frame = 1;
                } else {
                    global.current_frame = frame_count;
                }
            }
            
            frame_img = global.frames[global.current_frame];
            if (frame_img) {
                global.screen_sprite.SetImage(frame_img);
                global.screen_sprite.SetOpacity(1);
            }
        }

        // Penempatan posisi responsif di tengah
        pos_x = x + (w - global.anim_dim) / 2;
        pos_y = y + (h - global.anim_dim) / 2 - 40;
        if (position_mode == "top") {
            pos_y = y + h * 0.15;
        } else if (position_mode == "bottom") {
            pos_y = y + h * 0.7 - global.anim_dim;
        }
        global.anim_pos_y = pos_y;

        global.screen_sprite.SetPosition(pos_x, pos_y, 10);
    }

    refresh_callback();
    Plymouth.SetRefreshFunction(refresh_callback);
}

// Text rendering rapi tepat di bawah animasi
if (text_msg != "") {
    text_image = Image.Text(text_msg, text_r, text_g, text_b, 1, "Sans 16");
    if (text_image) {
        global.text_sprite = Sprite(text_image);
        fun message_refresh() {
            w = Window.GetWidth();
            h = Window.GetHeight();
            if (!w || w <= 0) w = 1280;
            if (!h || h <= 0) h = 720;
            x = Window.GetX();
            y = Window.GetY();
            if (!x) x = 0;
            if (!y) y = 0;
            tx = x + (w - text_image.GetWidth()) / 2;
            ty = global.anim_pos_y + global.anim_dim + 20;
            if (ty + text_image.GetHeight() > h) {
                ty = h - text_image.GetHeight() - 15;
            }
            global.text_sprite.SetPosition(tx, ty, 20);
            global.text_sprite.SetOpacity(1);
        }
        message_refresh();
    }
}

// Abaikan status teks acak systemd agar tidak mengotori layar
fun dummy_message_callback (text) {
}
Plymouth.SetDisplayMessageFunction(dummy_message_callback);
