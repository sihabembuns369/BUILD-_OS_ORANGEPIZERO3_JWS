# jws-animated.script - Dibuat otomatis untuk Orange Pi Zero 3 JWS
mode = "gif";
bg_r = 0.000;
bg_g = 0.000;
bg_b = 0.000;
scale_mode = "fit";
position_mode = "center";
frame_count = 30;
target_fps = 30;
loop_mode = 1;
text_msg = "";
text_r = 1.000;
text_g = 1.000;
text_b = 1.000;

# Background color
Window.SetBackgroundTopColor(bg_r, bg_g, bg_b);
Window.SetBackgroundBottomColor(bg_r, bg_g, bg_b);

# Sprite utama container animasi & teks
global.screen_sprite = Sprite();
global.text_sprite = Sprite();

# Ambil resolusi layar dinamis
screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
if (!screen_w || screen_w <= 0) screen_w = 1280;
if (!screen_h || screen_h <= 0) screen_h = 720;
screen_x = Window.GetX();
screen_y = Window.GetY();
if (!screen_x) screen_x = 0;
if (!screen_y) screen_y = 0;

# Ukuran responsif: 45% dari tinggi layar (min 140px, max 320px agar pas dengan frame 320x320 tanpa scaling ulang)
target_dim = Math.Int(screen_h * 0.45);
if (target_dim > 320) target_dim = 320;
if (target_dim < 140) target_dim = 140;

global.anim_dim = target_dim;

# Posisi terpusat responsif
pos_x = screen_x + Math.Int((screen_w - target_dim) / 2);
pos_y = screen_y + Math.Int((screen_h - target_dim) / 2) - 20;

if (position_mode == "top") {
    pos_y = screen_y + Math.Int(screen_h * 0.12);
} else if (position_mode == "bottom") {
    pos_y = screen_y + Math.Int(screen_h * 0.75) - target_dim;
}

global.anim_pos_x = pos_x;
global.anim_pos_y = pos_y;

if (mode == "image") {
    raw_img = Image("splash.png");
    if (!raw_img) {
        raw_img = Image("default_logo.png");
    }

    if (raw_img) {
        iw = raw_img.GetWidth();
        ih = raw_img.GetHeight();
        if (iw > 0 && ih > 0 && ih != target_dim) {
            scale_ratio = target_dim / ih;
            new_w = Math.Int(iw * scale_ratio);
            new_h = Math.Int(ih * scale_ratio);
            global.scaled_img = raw_img.Scale(new_w, new_h);
        } else {
            global.scaled_img = raw_img;
        }

        global.screen_sprite.SetImage(global.scaled_img);
        global.screen_sprite.SetPosition(screen_x + Math.Int((screen_w - global.scaled_img.GetWidth()) / 2), pos_y, 10);
        global.screen_sprite.SetOpacity(1);
    }

    fun refresh_callback () {
        w = Window.GetWidth();
        h = Window.GetHeight();
        if (w > 0 && h > 0 && global.scaled_img) {
            img_w = global.scaled_img.GetWidth();
            img_h = global.scaled_img.GetHeight();
            cur_x = Window.GetX();
            cur_y = Window.GetY();
            if (!cur_x) cur_x = 0;
            if (!cur_y) cur_y = 0;
            global.screen_sprite.SetPosition(cur_x + Math.Int((w - img_w) / 2), cur_y + Math.Int((h - img_h) / 2) - 20, 10);
            global.screen_sprite.SetOpacity(1);
        }
    }

    Plymouth.SetRefreshFunction(refresh_callback);

} else {
    # Mode Animation / Frames / GIF
    # Muat frame pertama segera agar boot logo langsung tampil seketika saat power dinyalakan
    raw_first = Image("frame_001.png");
    if (raw_first) {
        if (raw_first.GetWidth() == target_dim && raw_first.GetHeight() == target_dim) {
            global.frames[0] = raw_first;
        } else {
            global.frames[0] = raw_first.Scale(target_dim, target_dim);
        }
        global.screen_sprite.SetImage(global.frames[0]);
        global.screen_sprite.SetPosition(pos_x, pos_y, 10);
        global.screen_sprite.SetOpacity(1);
    }

    if (target_fps <= 0) target_fps = 15;
    divisor = Math.Int(50 / target_fps);
    if (divisor < 1) divisor = 1;

    global.progress = 0;

    fun refresh_callback () {
        if (frame_count > 0 && global.frames[0]) {
            if (loop_mode == 1) {
                frame_idx = Math.Int(global.progress / divisor) % frame_count;
            } else {
                frame_idx = Math.Int(global.progress / divisor);
                if (frame_idx >= frame_count) {
                    frame_idx = frame_count - 1;
                }
            }

            if (!global.frames[frame_idx]) {
                num = frame_idx + 1;
                idx_str = "";
                if (num < 10) idx_str = "00" + num;
                else if (num < 100) idx_str = "0" + num;
                else idx_str = "" + num;

                raw_frame = Image("frame_" + idx_str + ".png");
                if (raw_frame) {
                    if (raw_frame.GetWidth() == target_dim && raw_frame.GetHeight() == target_dim) {
                        global.frames[frame_idx] = raw_frame;
                    } else {
                        global.frames[frame_idx] = raw_frame.Scale(target_dim, target_dim);
                    }
                }
            }

            cur_frame = global.frames[frame_idx];
            if (cur_frame) {
                global.screen_sprite.SetImage(cur_frame);
            }

            w = Window.GetWidth();
            h = Window.GetHeight();
            if (w > 0 && h > 0) {
                cur_x = Window.GetX();
                cur_y = Window.GetY();
                if (!cur_x) cur_x = 0;
                if (!cur_y) cur_y = 0;
                global.screen_sprite.SetPosition(cur_x + Math.Int((w - target_dim) / 2), cur_y + Math.Int((h - target_dim) / 2) - 20, 10);
            }

            global.progress++;
        }
    }

    Plymouth.SetRefreshFunction(refresh_callback);
}

# Render teks konfigurasi jika diset
if (text_msg != "") {
    text_image = Image.Text(text_msg, text_r, text_g, text_b, 1, "Sans 16");
    if (text_image) {
        global.text_sprite.SetImage(text_image);
        tx = screen_x + Math.Int((screen_w - text_image.GetWidth()) / 2);
        ty = global.anim_pos_y + global.anim_dim + 25;
        if (ty + text_image.GetHeight() > screen_h) {
            ty = screen_h - text_image.GetHeight() - 15;
        }
        global.text_sprite.SetPosition(tx, ty, 20);
        global.text_sprite.SetOpacity(1);
    }
}

# Redam 100% status dan pesan internal systemd agar layar HDMI murni grafis
fun dummy_status_callback (status) {
}
Plymouth.SetUpdateStatusFunction(dummy_status_callback);

fun dummy_message_callback (text) {
}
Plymouth.SetDisplayMessageFunction(dummy_message_callback);

fun quit_callback () {
}
Plymouth.SetQuitFunction(quit_callback);
