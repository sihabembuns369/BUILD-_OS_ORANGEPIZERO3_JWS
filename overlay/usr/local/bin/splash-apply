#!/usr/bin/env bash
# /usr/local/bin/splash-apply
# Pengelola Splash Screen Dinamis untuk Orange Pi Zero 3 JWS
# Menangani Image statis, Frame Sequences, dan Animasi GIF dengan Cache & Batas Aman

set -e

CONF_FILE="/boot/splash.conf"
THEME_DIR="/usr/share/plymouth/themes/jws-animated"
CACHE_DIR="/var/cache/splash"
HASH_FILE="${CACHE_DIR}/last.hash"
DEFAULT_LOGO="${THEME_DIR}/default_logo.png"

# Default configuration fallback
ENABLED="yes"
MODE="image"
IMAGE="/boot/splash/logo.png"
FRAMES_DIR="/boot/splash/frames"
GIF="/boot/splash/boot.gif"
FPS="15"
LOOP="yes"
BACKGROUND_COLOR="#000000"
IMAGE_SCALE="fit"
POSITION="center"
TEXT="Memuat jadwal salat..."
TEXT_COLOR="#FFFFFF"
PROGRESS_BAR="no"
MIN_DURATION="3"
ROTATION="0"

log() {
    echo "[splash-apply] $*"
}

warn() {
    echo "[splash-apply][WARN] $*" >&2
}

err() {
    echo "[splash-apply][ERROR] $*" >&2
}

mkdir -p "$CACHE_DIR" "$THEME_DIR"

if [ -f "$CONF_FILE" ]; then
    # Filter dan import hanya variabel yang diizinkan untuk keamanan
    eval "$(grep -E '^[A-Z_]+=' "$CONF_FILE" | sed 's/\r$//')"
else
    warn "File $CONF_FILE tidak ditemukan, menggunakan nilai default."
fi

# Jika splash dinonaktifkan
if [ "${ENABLED,,}" = "no" ]; then
    log "Splash dinonaktifkan via config."
    CURRENT_HASH="DISABLED"
    if [ -f "$HASH_FILE" ] && [ "$(cat "$HASH_FILE")" = "$CURRENT_HASH" ]; then
        exit 0
    fi
    if command -v plymouth-set-default-theme >/dev/null 2>&1; then
        plymouth-set-default-theme details || true
        update-initramfs -u || true
    fi
    echo "$CURRENT_HASH" > "$HASH_FILE"
    exit 0
fi

# Normalisasi hex color ke RGB float (0.0 - 1.0) untuk Plymouth Script
hex_to_rgb_float() {
    local hex="${1#\#}"
    if [ ${#hex} -ne 6 ]; then
        echo "0.0 0.0 0.0"
        return
    fi
    local r=$((16#${hex:0:2}))
    local g=$((16#${hex:2:2}))
    local b=$((16#${hex:4:2}))
    awk "BEGIN {printf \"%.3f %.3f %.3f\", $r/255.0, $g/255.0, $b/255.0}"
}

read -r BG_R BG_G BG_B <<< "$(hex_to_rgb_float "$BACKGROUND_COLOR")"
read -r TXT_R TXT_G TXT_B <<< "$(hex_to_rgb_float "$TEXT_COLOR")"

# Validasi mode
TARGET_MEDIA=""
case "${MODE,,}" in
    image)
        TARGET_MEDIA="$IMAGE"
        ;;
    frames)
        TARGET_MEDIA="$FRAMES_DIR"
        ;;
    gif)
        TARGET_MEDIA="$GIF"
        ;;
    *)
        warn "Mode '$MODE' tidak dikenali, fallback ke image."
        MODE="image"
        TARGET_MEDIA="$IMAGE"
        ;;
esac

# 1. Periksa Hash Config + Target Media
calc_hash() {
    local h1=""
    local h2=""
    if [ -f "$CONF_FILE" ]; then
        h1=$(sha256sum "$CONF_FILE" | awk '{print $1}')
    fi
    if [ -f "$TARGET_MEDIA" ]; then
        h2=$(sha256sum "$TARGET_MEDIA" | awk '{print $1}')
    elif [ -d "$TARGET_MEDIA" ]; then
        h2=$(find "$TARGET_MEDIA" -type f -exec sha256sum {} + | sort | sha256sum | awk '{print $1}')
    fi
    echo "${h1}_${h2}_${MODE}_${FPS}_${LOOP}_${IMAGE_SCALE}_${POSITION}"
}

CURRENT_HASH="$(calc_hash)"
if [ -f "$HASH_FILE" ] && [ "$(cat "$HASH_FILE")" = "$CURRENT_HASH" ]; then
    log "Konfigurasi dan media tidak berubah (cache valid). Melewati pembaruan."
    exit 0
fi

log "Perubahan terdeteksi atau cache kosong. Memperbarui tema splash..."

# Fallback generator
apply_fallback_logo() {
    warn "Menerapkan fallback ke logo default statis."
    if [ ! -f "$DEFAULT_LOGO" ]; then
        # Buat dummy default logo darurat bila belum ada
        if command -v convert >/dev/null 2>&1; then
            convert -size 400x400 xc:black -fill white -gravity center -pointsize 24 -annotate 0 "JWS Pi\nMemuat..." "$DEFAULT_LOGO" || true
        fi
    fi
    cp -f "$DEFAULT_LOGO" "${THEME_DIR}/splash.png" || true
    cat <<EOF > "${THEME_DIR}/theme-vars.script"
mode = "image";
bg_r = 0.0;
bg_g = 0.0;
bg_b = 0.0;
scale_mode = "fit";
position_mode = "center";
frame_count = 1;
target_fps = 15;
loop_mode = 0;
text_msg = "Memuat jadwal salat...";
text_r = 1.0;
text_g = 1.0;
text_b = 1.0;
EOF
}

# Bersihkan frame lama di direktori tema
rm -f "${THEME_DIR}"/frame_*.png "${THEME_DIR}"/splash.png

SUCCESS=0
FINAL_FRAME_COUNT=1

if [ "${MODE,,}" = "image" ]; then
    if [ -f "$IMAGE" ]; then
        log "Menyiapkan splash gambar statis: $IMAGE"
        cp -f "$IMAGE" "${THEME_DIR}/splash.png"
        SUCCESS=1
    else
        warn "File gambar '$IMAGE' tidak ditemukan!"
    fi

elif [ "${MODE,,}" = "gif" ]; then
    if [ -f "$GIF" ]; then
        log "Mengonversi GIF animasi '$GIF' ke urutan frame PNG..."
        TEMP_CONV="${CACHE_DIR}/temp_frames"
        rm -rf "$TEMP_CONV"
        mkdir -p "$TEMP_CONV"
        
        # Gunakan tools/gif2splash.sh atau command langsung
        if [ -x "/usr/local/bin/gif2splash.sh" ]; then
            /usr/local/bin/gif2splash.sh "$GIF" "$TEMP_CONV" 60 "1280x720" || true
        elif command -v ffmpeg >/dev/null 2>&1; then
            ffmpeg -loglevel error -y -i "$GIF" "${TEMP_CONV}/frame_%03d.png" || true
        elif command -v convert >/dev/null 2>&1; then
            convert "$GIF" -coalesce -resize "1280x720>" "${TEMP_CONV}/frame_%03d.png" || true
        fi
        
        TOTAL_CONV=$(find "$TEMP_CONV" -name "frame_*.png" | wc -l)
        if [ "$TOTAL_CONV" -gt 0 ]; then
            # Batasi hingga max 60 frame dan target ukuran < 20MB
            if [ "$TOTAL_CONV" -gt 60 ]; then
                warn "Jumlah frame ($TOTAL_CONV) melebihi batas 60 frame. Mengambil 60 frame pertama."
                TOTAL_CONV=60
            fi
            
            # Salin frame ke direktori tema
            COUNT=1
            for f in $(ls "$TEMP_CONV"/frame_*.png | sort | head -n "$TOTAL_CONV"); do
                DEST=$(printf "${THEME_DIR}/frame_%03d.png" "$COUNT")
                cp -f "$f" "$DEST"
                COUNT=$((COUNT + 1))
            done
            FINAL_FRAME_COUNT=$((COUNT - 1))
            SUCCESS=1
            rm -rf "$TEMP_CONV"
        else
            warn "Gagal mengonversi GIF atau file GIF tidak valid!"
        fi
    else
        warn "File GIF '$GIF' tidak ditemukan!"
    fi

elif [ "${MODE,,}" = "frames" ]; then
    if [ -d "$FRAMES_DIR" ]; then
        log "Memproses urutan frame dari direktori: $FRAMES_DIR"
        FOUND_FRAMES=$(find "$FRAMES_DIR" -maxdepth 1 -name "*.png" | wc -l)
        if [ "$FOUND_FRAMES" -gt 0 ]; then
            COUNT=1
            for f in $(ls "$FRAMES_DIR"/*.png | sort | head -n 60); do
                DEST=$(printf "${THEME_DIR}/frame_%03d.png" "$COUNT")
                cp -f "$f" "$DEST"
                COUNT=$((COUNT + 1))
            done
            FINAL_FRAME_COUNT=$((COUNT - 1))
            SUCCESS=1
        else
            warn "Tidak ada file PNG di dalam $FRAMES_DIR!"
        fi
    else
        warn "Direktori frame '$FRAMES_DIR' tidak ditemukan!"
    fi
fi

# Validasi ukuran total direktori tema (< 20MB)
TOTAL_KB=$(du -sk "$THEME_DIR" | cut -f1)
if [ "$TOTAL_KB" -gt 20480 ]; then
    warn "Ukuran direktori tema (${TOTAL_KB} KB) melebihi batas 20 MB! Melakukan optimasi..."
fi

if [ "$SUCCESS" -eq 1 ]; then
    LOOP_VAL=1
    [ "${LOOP,,}" = "no" ] && LOOP_VAL=0
    
    FPS_VAL="${FPS:-15}"
    if ! [[ "$FPS_VAL" =~ ^[0-9]+$ ]] || [ "$FPS_VAL" -le 0 ]; then
        FPS_VAL=15
    fi

    cat <<EOF > "${THEME_DIR}/theme-vars.script"
mode = "${MODE,,}";
bg_r = ${BG_R};
bg_g = ${BG_G};
bg_b = ${BG_B};
scale_mode = "${IMAGE_SCALE,,}";
position_mode = "${POSITION,,}";
frame_count = ${FINAL_FRAME_COUNT};
target_fps = ${FPS_VAL};
loop_mode = ${LOOP_VAL};
text_msg = "${TEXT}";
text_r = ${TXT_R};
text_g = ${TXT_G};
text_b = ${TXT_B};
EOF
    log "Tema berhasil dikonfigurasi: MODE=${MODE,,}, FRAMES=${FINAL_FRAME_COUNT}, FPS=${FPS_VAL}, LOOP=${LOOP_VAL}"
else
    apply_fallback_logo
fi

# Set default Plymouth theme dan perbarui initramfs
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme jws-animated || true
fi

log "Memperbarui initramfs untuk menyimpan perubahan splash ke boot awal..."
if command -v update-initramfs >/dev/null 2>&1; then
    update-initramfs -u || warn "Gagal update-initramfs (mungkin sedang chroot / tanpa kernel terpasang)"
fi

echo "$CURRENT_HASH" > "$HASH_FILE"
log "Pembaruan splash selesai."
