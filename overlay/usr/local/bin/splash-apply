#!/usr/bin/env bash
# /usr/local/bin/splash-apply
# Pengelola Splash Screen Dinamis untuk Orange Pi Zero 3 JWS
# Menangani Image statis, Frame Sequences, dan Animasi GIF dengan Cache & Batas Aman

set -e

CONF_FILE="/boot/splash.conf"
THEME_DIR="/usr/share/plymouth/themes/jws-animated"
CACHE_DIR="/var/cache/splash"
HASH_FILE="${CACHE_DIR}/last.hash"
DEFAULT_LOGO="${THEME_DIR}/default_logo.png"

# Default configuration fallback
ENABLED="yes"
MODE="gif"
IMAGE="/boot/splash/logo.png"
FRAMES_DIR="/boot/splash/frames"
GIF="/boot/splash/boot.gif"
FPS="15"
LOOP="yes"
BACKGROUND_COLOR="#000000"
IMAGE_SCALE="fit"
POSITION="center"
TEXT="Memuat jadwal salat..."
TEXT_COLOR="#FFFFFF"
PROGRESS_BAR="no"
MIN_DURATION="3"
ROTATION="0"

log() {
    echo "[splash-apply] $*"
}

warn() {
    echo "[splash-apply][WARN] $*" >&2
}

err() {
    echo "[splash-apply][ERROR] $*" >&2
}

mkdir -p "$CACHE_DIR" "$THEME_DIR"

# Pastikan partisi /boot ter-mount jika belum
if [ ! -f "$CONF_FILE" ]; then
    if [ -b "/dev/disk/by-label/BOOT" ]; then
        mount /dev/disk/by-label/BOOT /boot 2>/dev/null || true
    elif [ -b "/dev/vda1" ]; then
        mount /dev/vda1 /boot 2>/dev/null || true
    elif [ -b "/dev/mmcblk0p1" ]; then
        mount /dev/mmcblk0p1 /boot 2>/dev/null || true
    fi
fi

# Aman membaca config tanpa eval
if [ -f "$CONF_FILE" ]; then
    while IFS='=' read -r key val || [ -n "$key" ]; do
        key=$(echo "$key" | tr -d ' \r\t')
        [[ "$key" =~ ^#.*$ ]] && continue
        [ -z "$key" ] && continue
        # Bersihkan komentar inline dan spasi
        val=$(echo "$val" | sed -E 's/[ \t]+#.*$//' | sed -e 's/^[ \t]*//' -e 's/[ \t\r]*$//')
        val="${val%\"}"
        val="${val#\"}"
        val="${val%\'}"
        val="${val#\'}"
        case "$key" in
            ENABLED) ENABLED="$val" ;;
            MODE) MODE="$val" ;;
            IMAGE) IMAGE="$val" ;;
            FRAMES_DIR) FRAMES_DIR="$val" ;;
            GIF) GIF="$val" ;;
            FPS) FPS="$val" ;;
            LOOP) LOOP="$val" ;;
            BACKGROUND_COLOR) BACKGROUND_COLOR="$val" ;;
            IMAGE_SCALE) IMAGE_SCALE="$val" ;;
            POSITION) POSITION="$val" ;;
            TEXT) TEXT="$val" ;;
            TEXT_COLOR) TEXT_COLOR="$val" ;;
            PROGRESS_BAR) PROGRESS_BAR="$val" ;;
            MIN_DURATION) MIN_DURATION="$val" ;;
            ROTATION) ROTATION="$val" ;;
        esac
    done < "$CONF_FILE"
else
    warn "File $CONF_FILE tidak ditemukan, menggunakan nilai default."
fi

# Jika splash dinonaktifkan
if [ "${ENABLED,,}" = "no" ]; then
    log "Splash dinonaktifkan via config."
    CURRENT_HASH="DISABLED"
    if [ -f "$HASH_FILE" ] && [ "$(cat "$HASH_FILE")" = "$CURRENT_HASH" ]; then
        exit 0
    fi
    if command -v plymouth-set-default-theme >/dev/null 2>&1; then
        plymouth-set-default-theme details 2>/dev/null || true
    fi
    echo "$CURRENT_HASH" > "$HASH_FILE"
    exit 0
fi

# Pure Bash hex color to RGB float (0.000 - 1.000)
hex_to_rgb_float() {
    local hex="${1#\#}"
    [ ${#hex} -ne 6 ] && hex="000000"
    local r=$((16#${hex:0:2}))
    local g=$((16#${hex:2:2}))
    local b=$((16#${hex:4:2}))
    printf "0.%03d 0.%03d 0.%03d" $((r * 1000 / 255)) $((g * 1000 / 255)) $((b * 1000 / 255))
}

read -r BG_R BG_G BG_B <<< "$(hex_to_rgb_float "$BACKGROUND_COLOR")"
read -r TXT_R TXT_G TXT_B <<< "$(hex_to_rgb_float "$TEXT_COLOR")"

# Validasi mode
TARGET_MEDIA=""
case "${MODE,,}" in
    image)
        TARGET_MEDIA="$IMAGE"
        ;;
    frames)
        TARGET_MEDIA="$FRAMES_DIR"
        ;;
    gif)
        TARGET_MEDIA="$GIF"
        ;;
    *)
        warn "Mode '$MODE' tidak dikenali, fallback ke image."
        MODE="image"
        TARGET_MEDIA="$IMAGE"
        ;;
esac

# 1. Periksa Hash Config + Target Media
calc_hash() {
    local h1=""
    local h2=""
    if [ -f "$CONF_FILE" ]; then
        h1=$(sha256sum "$CONF_FILE" 2>/dev/null | cut -d' ' -f1)
    fi
    if [ -f "$TARGET_MEDIA" ]; then
        h2=$(sha256sum "$TARGET_MEDIA" 2>/dev/null | cut -d' ' -f1)
    elif [ -d "$TARGET_MEDIA" ]; then
        h2=$(find "$TARGET_MEDIA" -maxdepth 1 -type f 2>/dev/null | sort | head -n 60 | sha256sum | cut -d' ' -f1)
    fi
    echo "${h1}_${h2}_${MODE}_${FPS}_${LOOP}_${IMAGE_SCALE}_${POSITION}"
}

CURRENT_HASH="$(calc_hash)"
if [ -f "$HASH_FILE" ] && [ "$(cat "$HASH_FILE")" = "$CURRENT_HASH" ]; then
    log "Konfigurasi dan media tidak berubah (cache valid). Melewati pembaruan."
    exit 0
fi

log "Perubahan terdeteksi atau cache kosong. Memperbarui tema splash..."

write_plymouth_script() {
    local m="$1"
    local fc="$2"
    local tfps="$3"
    local lmode="$4"
    local smode="$5"
    local pmode="$6"
    local bgr="$7"
    local bgg="$8"
    local bgb="$9"
    local tmsg="${10}"
    local tr="${11}"
    local tg="${12}"
    local tb="${13}"

    cat <<EOF > "${THEME_DIR}/jws-animated.script"
// jws-animated.script - Dibuat otomatis oleh splash-apply
mode = "${m}";
bg_r = ${bgr};
bg_g = ${bgg};
bg_b = ${bgb};
scale_mode = "${smode}";
position_mode = "${pmode}";
frame_count = ${fc};
target_fps = ${tfps};
loop_mode = ${lmode};
text_msg = "${tmsg}";
text_r = ${tr};
text_g = ${tg};
text_b = ${tb};

EOF
    if [ -f "${THEME_DIR}/jws-animated.script.template" ]; then
        cat "${THEME_DIR}/jws-animated.script.template" >> "${THEME_DIR}/jws-animated.script"
    fi
}

apply_fallback_logo() {
    warn "Menerapkan fallback ke logo default statis."
    if [ -f "$DEFAULT_LOGO" ]; then
        cp -f "$DEFAULT_LOGO" "${THEME_DIR}/splash.png" 2>/dev/null || true
    fi
    write_plymouth_script "image" 1 15 0 "fit" "center" 0.000 0.000 0.000 "Memuat jadwal salat..." 1.000 1.000 1.000
}

SUCCESS=0
FINAL_FRAME_COUNT=1

if [ "${MODE,,}" = "image" ]; then
    if [ -f "$IMAGE" ]; then
        log "Menyiapkan splash gambar statis: $IMAGE"
        cp -f "$IMAGE" "${THEME_DIR}/splash.png"
        SUCCESS=1
    else
        warn "File gambar '$IMAGE' tidak ditemukan!"
    fi

elif [ "${MODE,,}" = "gif" ]; then
    if [ -f "$GIF" ]; then
        log "Menyiapkan animasi GIF '$GIF'..."
        TEMP_CONV="${CACHE_DIR}/temp_frames"
        rm -rf "$TEMP_CONV"
        mkdir -p "$TEMP_CONV"
        
        if [ -x "/usr/local/bin/gif2splash.sh" ]; then
            /usr/local/bin/gif2splash.sh "$GIF" "$TEMP_CONV" 60 "1280x720" 2>/dev/null || true
        elif command -v ffmpeg >/dev/null 2>&1; then
            ffmpeg -loglevel error -y -i "$GIF" "${TEMP_CONV}/frame_%03d.png" 2>/dev/null || true
        fi
        
        TOTAL_CONV=$(find "$TEMP_CONV" -maxdepth 1 -name "frame_*.png" 2>/dev/null | wc -l)
        if [ "$TOTAL_CONV" -gt 0 ]; then
            [ "$TOTAL_CONV" -gt 60 ] && TOTAL_CONV=60
            rm -f "${THEME_DIR}"/frame_*.png
            COUNT=1
            for f in $(ls "$TEMP_CONV"/frame_*.png | sort | head -n "$TOTAL_CONV"); do
                DEST=$(printf "${THEME_DIR}/frame_%03d.png" "$COUNT")
                cp -f "$f" "$DEST"
                COUNT=$((COUNT + 1))
            done
            FINAL_FRAME_COUNT=$((COUNT - 1))
            SUCCESS=1
            rm -rf "$TEMP_CONV"
        elif [ -d "$FRAMES_DIR" ] && [ "$(find "$FRAMES_DIR" -maxdepth 1 -name "*.png" 2>/dev/null | wc -l)" -gt 0 ]; then
            log "Menggunakan frame hasil pra-konversi dari: $FRAMES_DIR"
            COUNT=1
            rm -f "${THEME_DIR}"/frame_*.png
            for f in $(ls "$FRAMES_DIR"/*.png | sort | head -n 60); do
                DEST=$(printf "${THEME_DIR}/frame_%03d.png" "$COUNT")
                cp -f "$f" "$DEST"
                COUNT=$((COUNT + 1))
            done
            FINAL_FRAME_COUNT=$((COUNT - 1))
            SUCCESS=1
        elif [ "$(find "$THEME_DIR" -maxdepth 1 -name "frame_*.png" 2>/dev/null | wc -l)" -gt 0 ]; then
            log "Menggunakan frame animasi bawaan yang telah terpasang di tema."
            FINAL_FRAME_COUNT=$(find "$THEME_DIR" -maxdepth 1 -name "frame_*.png" 2>/dev/null | wc -l)
            SUCCESS=1
        else
            warn "Gagal mengonversi GIF dan tidak ada frame cadangan. Fallback ke logo statis."
        fi
    else
        warn "File GIF '$GIF' tidak ditemukan!"
    fi

elif [ "${MODE,,}" = "frames" ]; then
    if [ -d "$FRAMES_DIR" ]; then
        log "Memproses urutan frame dari direktori: $FRAMES_DIR"
        FOUND_FRAMES=$(find "$FRAMES_DIR" -maxdepth 1 -name "*.png" 2>/dev/null | wc -l)
        if [ "$FOUND_FRAMES" -gt 0 ]; then
            rm -f "${THEME_DIR}"/frame_*.png
            COUNT=1
            for f in $(ls "$FRAMES_DIR"/*.png | sort | head -n 60); do
                DEST=$(printf "${THEME_DIR}/frame_%03d.png" "$COUNT")
                cp -f "$f" "$DEST"
                COUNT=$((COUNT + 1))
            done
            FINAL_FRAME_COUNT=$((COUNT - 1))
            SUCCESS=1
        else
            warn "Tidak ada file PNG di dalam $FRAMES_DIR!"
        fi
    else
        warn "Direktori frame '$FRAMES_DIR' tidak ditemukan!"
    fi
fi

if [ "$SUCCESS" -eq 1 ]; then
    LOOP_VAL=1
    [ "${LOOP,,}" = "no" ] && LOOP_VAL=0
    FPS_VAL="${FPS:-15}"
    if ! [[ "$FPS_VAL" =~ ^[0-9]+$ ]] || [ "$FPS_VAL" -le 0 ]; then
        FPS_VAL=15
    fi

    write_plymouth_script "${MODE,,}" "${FINAL_FRAME_COUNT}" "${FPS_VAL}" "${LOOP_VAL}" "${IMAGE_SCALE,,}" "${POSITION,,}" "${BG_R}" "${BG_G}" "${BG_B}" "${TEXT}" "${TXT_R}" "${TXT_G}" "${TXT_B}"
    log "Tema Plymouth dikonfigurasi: MODE=${MODE,,}, FRAMES=${FINAL_FRAME_COUNT}, FPS=${FPS_VAL}, LOOP=${LOOP_VAL}"
else
    apply_fallback_logo
fi

if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme jws-animated 2>/dev/null || true
fi

# Update initramfs dengan batas waktu maksimal 10 detik agar boot tidak pernah terhambat
if command -v update-initramfs >/dev/null 2>&1; then
    timeout 10 update-initramfs -u 2>/dev/null || true
fi

echo "$CURRENT_HASH" > "$HASH_FILE"
log "Pembaruan splash selesai."
