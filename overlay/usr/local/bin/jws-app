#!/usr/bin/env bash
# /usr/local/bin/jws-app
# Launcher untuk Aplikasi Jadwal Waktu Salat (SDL2 + ImGui)

if [ -x "/opt/jws/jws" ]; then
    # Tutup splash screen tepat saat aplikasi siap dieksekusi
    plymouth quit --retain-splash 2>/dev/null || true
    exec /opt/jws/jws "$@"
elif [ -x "/usr/local/bin/jws-bin" ]; then
    plymouth quit --retain-splash 2>/dev/null || true
    exec /usr/local/bin/jws-bin "$@"
else
    # Tampilkan splash screen selama beberapa detik agar animasi boot selesai berputar
    sleep 4
    # Tutup splash screen agar tidak menggantung tanpa batas waktu jika biner belum dipasang
    plymouth quit 2>/dev/null || true
    
    echo "=========================================================="
    echo " JWS KIOSK STANDBY"
    echo " Sistem siap. Menunggu binary aplikasi di: /opt/jws/jws"
    echo "=========================================================="
    while true; do
        if [ -x "/opt/jws/jws" ]; then
            exec /opt/jws/jws "$@"
        fi
        sleep 5
    done
fi
