#!/usr/bin/env bash
# /usr/local/bin/jws-app
# Launcher untuk Aplikasi Jadwal Waktu Salat (SDL2 + ImGui)

if [ -x "/opt/jws/jws" ]; then
    exec /opt/jws/jws "$@"
elif [ -x "/usr/local/bin/jws-bin" ]; then
    exec /usr/local/bin/jws-bin "$@"
else
    # Fallback status runner jika aplikasi binary spesifik belum disalin ke rootfs
    echo "Aplikasi JWS siap. Menunggu binary jadwal salat di /opt/jws/jws..."
    while true; do
        sleep 60
    done
fi
