#!/usr/bin/env bash
# /usr/local/bin/jws-app
# Launcher untuk Aplikasi Jadwal Waktu Salat (SDL2 + ImGui)

if [ -x "/opt/jws/jws" ]; then
    # Eksekusi aplikasi JWS; aplikasi menutup splash saat frame pertama siap (Anbernic style)
    exec /opt/jws/jws "$@"
elif [ -x "/usr/local/bin/jws-bin" ]; then
    exec /usr/local/bin/jws-bin "$@"
else
    # Tahan splash screen selama 5 detik agar logo dapat dilihat
    sleep 5
    plymouth quit 2>/dev/null || true

    # Bersihkan layar HDMI (/dev/tty1) dan sembunyikan kursor
    clear
    printf "\033[?25l"

    cat <<'EOF'

  ==============================================================
             ORANGE PI ZERO 3 - JADWAL WAKTU SALAT (JWS)
  ==============================================================
   [OK] Sistem Linux Debian Minimalis Siap & Aktif
   [OK] Audio, WiFi, Bluetooth, & HDMI DRM Driver Loaded
   [OK] Akses Debug UART : Aktif di ttyS0 (Auto-login: jws)
   [OK] Remote SSH Server: Aktif di Port 22 (ssh jws@jws-pi.local)
  --------------------------------------------------------------
   STATUS: STANDBY (BOOT SELESAI)
   Menunggu berkas biner aplikasi di: /opt/jws/jws
   (Aplikasi otomatis berjalan fullscreen begitu file tersedia)
  ==============================================================

EOF

    while true; do
        if [ -x "/opt/jws/jws" ]; then
            printf "\033[?25h"
            clear
            exec /opt/jws/jws "$@"
        fi
        sleep 3
    done
fi
