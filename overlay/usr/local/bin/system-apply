#!/usr/bin/env bash
# /usr/local/bin/system-apply
# Konfigurasi sistem dinamis Orange Pi Zero 3 JWS dari /boot/system.conf dan /boot/wifi.conf

set -e

# Pastikan partisi /boot ter-mount
if ! mountpoint -q /boot; then
    mount /dev/disk/by-label/BOOT /boot 2>/dev/null || \
    mount /dev/mmcblk0p1 /boot 2>/dev/null || \
    mount /dev/vda1 /boot 2>/dev/null || true
fi

SYS_CONF="/boot/system.conf"
WIFI_CONF="/boot/wifi.conf"

HOSTNAME="jws-pi"
SSH_ENABLED="yes"
SSH_PORT="22"
SSH_PASSWORD_AUTH="yes"
SERIAL_CONSOLE="yes"
SERIAL_BAUD="115200"

log() {
    echo "[system-apply] $*"
}

warn() {
    echo "[system-apply][WARN] $*" >&2
}

if [ -f "$SYS_CONF" ]; then
    eval "$(grep -E '^[A-Z_]+=' "$SYS_CONF" | sed 's/\r$//')"
else
    warn "File $SYS_CONF tidak ditemukan, menggunakan nilai default."
fi

# 1. Atur Hostname
if [ -n "$HOSTNAME" ]; then
    CURRENT_HOST=$(cat /etc/hostname 2>/dev/null || echo "")
    if [ "$CURRENT_HOST" != "$HOSTNAME" ]; then
        log "Mengubah hostname menjadi '$HOSTNAME'..."
        echo "$HOSTNAME" > /etc/hostname
        hostname "$HOSTNAME" 2>/dev/null || true
        sed -i "s/127\.0\.1\.1.*/127.0.1.1\t$HOSTNAME/g" /etc/hosts 2>/dev/null || echo -e "127.0.1.1\t$HOSTNAME" >> /etc/hosts
    fi
fi

# 2. Atur SSH Server
if [ "${SSH_ENABLED,,}" = "yes" ]; then
    if ! [[ "$SSH_PORT" =~ ^[0-9]+$ ]] || [ "$SSH_PORT" -lt 1 ] || [ "$SSH_PORT" -gt 65535 ]; then
        warn "Port SSH tidak valid ($SSH_PORT), menggunakan port 22."
        SSH_PORT=22
    fi
    
    SSHD_DROPIN_DIR="/etc/ssh/sshd_config.d"
    mkdir -p "$SSHD_DROPIN_DIR"
    
    PASS_AUTH_VAL="no"
    [ "${SSH_PASSWORD_AUTH,,}" = "yes" ] && PASS_AUTH_VAL="yes"
    
    cat <<EOF > "${SSHD_DROPIN_DIR}/50-jws.conf"
Port ${SSH_PORT}
PermitRootLogin no
PasswordAuthentication ${PASS_AUTH_VAL}
KbdInteractiveAuthentication ${PASS_AUTH_VAL}
PubkeyAuthentication yes
EOF
fi

# 3. Pastikan konfigurasi dasar wpa_supplicant tersedia & terapkan wifi.conf bila ada
mkdir -p /etc/wpa_supplicant /var/run/wpa_supplicant
WPA_SUP_FILE="/etc/wpa_supplicant/wpa_supplicant.conf"
if [ ! -f "$WPA_SUP_FILE" ]; then
    cat <<EOF > "$WPA_SUP_FILE"
ctrl_interface=/var/run/wpa_supplicant
update_config=1
EOF
fi

if [ -f "$WIFI_CONF" ]; then
    WIFI_ENABLED="no"
    WIFI_SSID=""
    WIFI_PASSWORD=""
    WIFI_COUNTRY="ID"
    eval "$(grep -E '^[A-Z_]+=' "$WIFI_CONF" | sed 's/\r$//')"
    
    if [ "${WIFI_ENABLED,,}" = "yes" ] && [ -n "$WIFI_SSID" ]; then
        log "Mengonfigurasi WiFi headless untuk SSID: $WIFI_SSID..."
        cat <<EOF > "$WPA_SUP_FILE"
ctrl_interface=/var/run/wpa_supplicant
update_config=1
country=${WIFI_COUNTRY:-ID}

network={
    ssid="${WIFI_SSID}"
    psk="${WIFI_PASSWORD}"
}
EOF
        chmod 600 "$WPA_SUP_FILE"
    fi
fi
cp -f "$WPA_SUP_FILE" /etc/wpa_supplicant.conf 2>/dev/null || true

# 4. Deteksi otomatis GPIO controller utama Allwinner H618 (300b000.pinctrl) untuk PC14 (Line 78)
IR_ENABLED="${IR_ENABLED:-yes}"
IR_LINE="${IR_LINE:-78}"
DETECTED_PIO_CHIP=""
for gc in /sys/bus/platform/devices/*300b000.pinctrl/gpiochip*; do
    if [ -e "$gc" ]; then
        DETECTED_PIO_CHIP="/dev/$(basename "$gc")"
        break
    fi
done
if [ -n "$DETECTED_PIO_CHIP" ] && [ "${IR_LINE:-78}" -ge 32 ]; then
    IR_CHIP="$DETECTED_PIO_CHIP"
else
    IR_CHIP="${IR_CHIP:-/dev/gpiochip0}"
fi

if [ -f "/opt/jws/settings.json" ]; then
    IR_BOOL="true"
    case "${IR_ENABLED,,}" in
        no|0|false) IR_BOOL="false" ;;
    esac
    log "Sinkronisasi pin IR: chip=${IR_CHIP}, line=${IR_LINE}, enabled=${IR_BOOL}..."
    sed -i \
        -e "s|\"irChip\"[[:space:]]*:[[:space:]]*\"[^\"]*\"|\"irChip\": \"${IR_CHIP}\"|g" \
        -e "s|\"irLine\"[[:space:]]*:[[:space:]]*[0-9]*|\"irLine\": ${IR_LINE}|g" \
        -e "s|\"irEnabled\"[[:space:]]*:[[:space:]]*[a-z]*|\"irEnabled\": ${IR_BOOL}|g" \
        /opt/jws/settings.json 2>/dev/null || true
fi

log "System apply selesai."
