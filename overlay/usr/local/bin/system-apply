#!/usr/bin/env bash
# /usr/local/bin/system-apply
# Konfigurasi sistem dinamis Orange Pi Zero 3 JWS dari /boot/system.conf dan /boot/wifi.conf

set -e

SYS_CONF="/boot/system.conf"
WIFI_CONF="/boot/wifi.conf"

HOSTNAME="jws-pi"
SSH_ENABLED="yes"
SSH_PORT="22"
SSH_PASSWORD_AUTH="no"
SERIAL_CONSOLE="yes"
SERIAL_BAUD="115200"

log() {
    echo "[system-apply] $*"
}

warn() {
    echo "[system-apply][WARN] $*" >&2
}

if [ -f "$SYS_CONF" ]; then
    eval "$(grep -E '^[A-Z_]+=' "$SYS_CONF" | sed 's/\r$//')"
else
    warn "File $SYS_CONF tidak ditemukan, menggunakan nilai default."
fi

# 1. Atur Hostname
if [ -n "$HOSTNAME" ]; then
    CURRENT_HOST=$(cat /etc/hostname 2>/dev/null || echo "")
    if [ "$CURRENT_HOST" != "$HOSTNAME" ]; then
        log "Mengubah hostname menjadi '$HOSTNAME'..."
        echo "$HOSTNAME" > /etc/hostname
        hostname "$HOSTNAME" || true
        # Update /etc/hosts
        sed -i "s/127\.0\.1\.1.*/127.0.1.1\t$HOSTNAME/g" /etc/hosts || echo -e "127.0.1.1\t$HOSTNAME" >> /etc/hosts
    fi
fi

# 2. Atur SSH Server
if [ "${SSH_ENABLED,,}" = "yes" ]; then
    systemctl unmask ssh || true
    systemctl enable ssh || true
    systemctl start ssh || true
    
    # Validasi port
    if ! [[ "$SSH_PORT" =~ ^[0-9]+$ ]] || [ "$SSH_PORT" -lt 1 ] || [ "$SSH_PORT" -gt 65535 ]; then
        warn "Port SSH tidak valid ($SSH_PORT), menggunakan port 22."
        SSH_PORT=22
    fi
    
    # Update konfigurasi SSH
    SSHD_DROPIN_DIR="/etc/ssh/sshd_config.d"
    mkdir -p "$SSHD_DROPIN_DIR"
    
    PASS_AUTH_VAL="no"
    [ "${SSH_PASSWORD_AUTH,,}" = "yes" ] && PASS_AUTH_VAL="yes"
    
    cat <<EOF > "${SSHD_DROPIN_DIR}/50-jws.conf"
Port ${SSH_PORT}
PermitRootLogin no
PasswordAuthentication ${PASS_AUTH_VAL}
PubkeyAuthentication yes
EOF
    systemctl reload ssh || true
else
    log "Menonaktifkan SSH service..."
    systemctl stop ssh || true
    systemctl disable ssh || true
fi

# 3. Atur Serial Console
if [ "${SERIAL_CONSOLE,,}" = "yes" ]; then
    systemctl enable "serial-getty@ttyS0.service" || true
    systemctl start "serial-getty@ttyS0.service" || true
else
    systemctl stop "serial-getty@ttyS0.service" || true
    systemctl disable "serial-getty@ttyS0.service" || true
fi

# 4. Atur WiFi Headless jika ada wifi.conf
if [ -f "$WIFI_CONF" ]; then
    WIFI_ENABLED="no"
    WIFI_SSID=""
    WIFI_PASSWORD=""
    WIFI_COUNTRY="ID"
    eval "$(grep -E '^[A-Z_]+=' "$WIFI_CONF" | sed 's/\r$//')"
    
    if [ "${WIFI_ENABLED,,}" = "yes" ] && [ -n "$WIFI_SSID" ]; then
        log "Mengonfigurasi WiFi headless untuk SSID: $WIFI_SSID..."
        WPA_SUP_FILE="/etc/wpa_supplicant/wpa_supplicant.conf"
        mkdir -p /etc/wpa_supplicant
        cat <<EOF > "$WPA_SUP_FILE"
ctrl_interface=DIR=/var/run/wpa_supplicant GROUP=netdev
update_config=1
country=${WIFI_COUNTRY:-ID}

network={
    ssid="${WIFI_SSID}"
    psk="${WIFI_PASSWORD}"
}
EOF
        chmod 600 "$WPA_SUP_FILE"
        systemctl restart wpa_supplicant || true
    fi
fi

log "System apply selesai."
