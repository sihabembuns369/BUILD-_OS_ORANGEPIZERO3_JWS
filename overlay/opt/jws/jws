#!/usr/bin/env bash
# /opt/jws/jws
# Launcher Aplikasi Jadwal Salat ImGui untuk Orange Pi Zero 3 & QEMU

APP_DIR="/opt/jws"
cd "$APP_DIR" || exit 1

export LD_LIBRARY_PATH="$APP_DIR/lib:$LD_LIBRARY_PATH"
export SDL_AUDIODRIVER="${SDL_AUDIODRIVER:-dummy}"

# Set CPU governor ke performance untuk kelancaran rendering UI 60 FPS
for gov in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    [ -f "$gov" ] && echo "performance" > "$gov" 2>/dev/null || true
done

# Optimasi rendering SDL2 & Mesa agar lancar dan tidak patah-patah
export SDL_HINT_RENDER_BATCHING=1
export LP_NUM_THREADS=2
export GALLIUM_DRIVER=llvmpipe
export MESA_GL_VERSION_OVERRIDE=2.1
export MESA_GLES_VERSION_OVERRIDE=2.0

# Mode framebuffer DRM/KMS jika berjalan langsung di tty tanpa server display X11/Wayland
if [ -z "$DISPLAY" ] && [ -z "$WAYLAND_DISPLAY" ]; then
    export SDL_VIDEODRIVER=kmsdrm
fi

# Deteksi lingkungan QEMU: gunakan VirGL 3D native jika tersedia (virtio-gpu-gl-pci),
# atau fallback ke software kms_swrast jika hanya virtio-gpu 2D tanpa VirGL.
if [ -d "/sys/bus/pci/drivers/virtio-pci" ] || [ -d "/sys/module/virtio_gpu" ] || grep -q "QEMU" /proc/cpuinfo 2>/dev/null; then
    VIRGL_ACTIVE=0
    for feat in /sys/bus/virtio/drivers/virtio_gpu/virtio*/features; do
        if [ -r "$feat" ] && [ "$(head -c 1 "$feat")" = "1" ]; then
            VIRGL_ACTIVE=1
            break
        fi
    done
    if [ "$VIRGL_ACTIVE" -eq 0 ]; then
        export LIBGL_ALWAYS_SOFTWARE=1
        export MESA_LOADER_DRIVER_OVERRIDE=kms_swrast
        export GALLIUM_DRIVER=llvmpipe
        export LP_NUM_THREADS=1
    fi
fi

# Pastikan MIN_DURATION dari /boot/splash.conf terpenuhi sebelum menutup splash
MIN_DUR=3
if [ -f /boot/splash.conf ]; then
    while IFS='=' read -r k v; do
        k="${k//[[:space:]]/}"
        if [ "$k" = "MIN_DURATION" ]; then
            v="${v%%#*}"
            v="${v//[[:space:]\"\']/}"
            [[ "$v" =~ ^[0-9]+$ ]] && MIN_DUR="$v"
            break
        fi
    done < /boot/splash.conf
fi
UPTIME_SEC="${SECONDS}"
if [ -r /proc/uptime ]; then
    read -r up _ < /proc/uptime
    UPTIME_SEC="${up%%.*}"
fi
if [ "${UPTIME_SEC:-10}" -lt "$MIN_DUR" ]; then
    sleep $((MIN_DUR - UPTIME_SEC))
fi

# Jika plymouth masih berjalan, tutup agar Plymouth melepaskan DRM master ke SDL2
if [ -e /run/plymouth/pid ] || /usr/bin/plymouth --ping 2>/dev/null; then
    /usr/bin/plymouth quit 2>/dev/null || true
fi

# Pastikan perangkat input dan tty1 dapat diakses penuh oleh SDL2 evdev
sudo /bin/chmod 666 /dev/input/event* /dev/input/mice /dev/input/mouse* /dev/tty1 /dev/tty0 2>/dev/null || true

echo "[JWS] Meluncurkan aplikasi jadwal salat ImGui..."
if [ -r /dev/tty1 ]; then
    exec "$APP_DIR/jadwalsholat_imgui" "$@" </dev/tty1
else
    exec "$APP_DIR/jadwalsholat_imgui" "$@"
fi
