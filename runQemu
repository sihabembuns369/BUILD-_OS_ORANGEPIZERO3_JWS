#!/usr/bin/env bash
# runQemu
# Skrip eksekusi simulasi sistem di QEMU ARM64

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMG_FILE="${1:-${SCRIPT_DIR}/output/orangepi_zero3_jws.img}"
KERNEL_IMG="${SCRIPT_DIR}/output/Image"

if [ ! -f "$IMG_FILE" ]; then
    # Cari image fallback
    if [ -f "${SCRIPT_DIR}/orangepi_fat32.img" ]; then
        IMG_FILE="${SCRIPT_DIR}/orangepi_fat32.img"
    elif [ -f "${SCRIPT_DIR}/build/output/orangepi_zero3_jws.img" ]; then
        IMG_FILE="${SCRIPT_DIR}/build/output/orangepi_zero3_jws.img"
    else
        echo "Error: Image file '$IMG_FILE' tidak ditemukan!"
        echo "Jalankan build terlebih dahulu: ./scripts/04_create_image.sh"
        exit 1
    fi
fi

# Pengaturan Resolusi Layar (Landscape 16:9 Widescreen)
RES_X="${RES_X:-1280}"
RES_Y="${RES_Y:-720}"

# Pilihan mode display: jika ada DISPLAY, buka window GUI SDL/GTK; jika tidak ada (headless/SSH), buka VNC di localhost:5901
DISPLAY_OPTS=""
if [ -n "$DISPLAY" ]; then
    DISPLAY_OPTS="-device virtio-gpu-gl-pci,xres=${RES_X},yres=${RES_Y} -display sdl,gl=on"
else
    echo "Peringatan: Variabel DISPLAY tidak diset. Menjalankan dalam mode headless dengan VNC aktif di 127.0.0.1:5901."
    DISPLAY_OPTS="-device virtio-gpu-pci,xres=${RES_X},yres=${RES_Y} -display vnc=127.0.0.1:1"
fi

KERNEL_OPTS=""
if [ -f "$KERNEL_IMG" ]; then
    KERNEL_OPTS="-kernel ${KERNEL_IMG} -append \"root=/dev/vda2 rw rootwait console=tty1 console=ttyAMA0,115200 quiet splash loglevel=3 plymouth.ignore-serial-consoles plymouth.ignore-udev vt.global_cursor_default=0\""
fi

SSH_PORT="${SSH_PORT:-22220}"
if ss -tulpn | grep -q ":2222 "; then
    SSH_PORT=22220
fi

WEB_PORT="${WEB_PORT:-8080}"
if ss -tulpn 2>/dev/null | grep -q ":8080 "; then
    WEB_PORT=28080
fi

echo "==> Menjalankan QEMU aarch64..."
echo "==> Image   : $IMG_FILE"
echo "==> SSH Port: $SSH_PORT (ssh -p $SSH_PORT jws@localhost, password: jws)"
echo "==> Web JWS : http://localhost:${WEB_PORT}"
echo "==> Keluar  : Tekan Ctrl+A lalu X"

# Workaround bug QEMU 6.x + VirGL: setelah guest reboot, konteks virglrenderer di host
# tidak ter-reset ("map failed for element buffer") sehingga aplikasi tertahan di splash.
# Solusi: guest reboot -> QEMU keluar (-no-reboot) -> skrip ini menjalankan ulang QEMU baru.
# Guest shutdown/poweroff -> QEMU keluar dan skrip selesai.
REBOOT_OPTS=""
QMP_SOCK=""
EVENT_LOG=""
if command -v socat >/dev/null 2>&1; then
    QMP_SOCK="/tmp/jws-qemu-qmp.$$.sock"
    EVENT_LOG="/tmp/jws-qemu-events.$$.log"
    REBOOT_OPTS="-no-reboot -qmp unix:${QMP_SOCK},server,nowait"
    trap 'rm -f "$QMP_SOCK" "$EVENT_LOG"' EXIT
fi

while true; do
  WATCH_PID=""
  if [ -n "$QMP_SOCK" ]; then
    rm -f "$QMP_SOCK"; : > "$EVENT_LOG"
    (
      for _ in $(seq 1 100); do [ -S "$QMP_SOCK" ] && break; sleep 0.1; done
      { echo '{"execute":"qmp_capabilities"}'; while [ -S "$QMP_SOCK" ]; do sleep 1; done; } \
        | socat - UNIX-CONNECT:"$QMP_SOCK" >> "$EVENT_LOG" 2>/dev/null
    ) &
    WATCH_PID=$!
  fi

  RC=0
  eval qemu-system-aarch64 \
    -M virt \
    -cpu cortex-a53 \
    -smp 4 \
    -m 512M \
    ${KERNEL_OPTS} \
    -drive file="${IMG_FILE}",format=raw,if=virtio \
    ${DISPLAY_OPTS} \
    -serial stdio \
    -device virtio-keyboard-pci \
    -device virtio-mouse-pci \
    -rtc base=localtime \
    -netdev user,id=net0,hostfwd=tcp::${SSH_PORT}-:22,hostfwd=tcp::${WEB_PORT}-:8080 \
    -device virtio-net-pci,netdev=net0 \
    ${REBOOT_OPTS} || RC=$?

  [ -n "$WATCH_PID" ] && { kill "$WATCH_PID" 2>/dev/null || true; wait "$WATCH_PID" 2>/dev/null || true; }

  if [ -n "$EVENT_LOG" ] && grep -q '"guest-reset"' "$EVENT_LOG" 2>/dev/null; then
    echo ""
    echo "==> Guest melakukan reboot: menjalankan ulang QEMU (reset bersih VirGL)..."
    sleep 1
    continue
  fi
  exit $RC
done
