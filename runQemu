qemu-system-aarch64 \
  -M virt \
  -cpu cortex-a53 \
  -m 2G \
  -kernel linux/arch/arm64/boot/Image \
  -append "console=ttyAMA0 , 115200 earlyprintk root=/dev/vda1 rw root=/dev/vda2 rw loglevel=8 init=/sbin/init" \
  -drive file=orangepi_fat32.img,format=raw,if=virtio \
  -device virtio-gpu-gl-pci \
  -display sdl,gl=on \
  -serial stdio \
  -device virtio-keyboard-pci \
     -device virtio-mouse-pci \
     -rtc base=localtime \
  -netdev user,id=net0,hostfwd=tcp::2222-:22 \
  -device virtio-net-pci,netdev=net0



