#!/usr/bin/env bash
# runQemu
# Skrip eksekusi simulasi sistem di QEMU ARM64

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMG_FILE="${1:-${SCRIPT_DIR}/output/orangepi_zero3_jws.img}"
KERNEL_IMG="${SCRIPT_DIR}/output/Image"

if [ ! -f "$IMG_FILE" ]; then
    # Cari image fallback
    if [ -f "${SCRIPT_DIR}/orangepi_fat32.img" ]; then
        IMG_FILE="${SCRIPT_DIR}/orangepi_fat32.img"
    elif [ -f "${SCRIPT_DIR}/build/output/orangepi_zero3_jws.img" ]; then
        IMG_FILE="${SCRIPT_DIR}/build/output/orangepi_zero3_jws.img"
    else
        echo "Error: Image file '$IMG_FILE' tidak ditemukan!"
        echo "Jalankan build terlebih dahulu: ./scripts/04_create_image.sh"
        exit 1
    fi
fi

# Pengaturan Resolusi Layar (Landscape 16:9 Widescreen)
RES_X="${RES_X:-1280}"
RES_Y="${RES_Y:-720}"

# Pilihan mode display: jika tidak ada DISPLAY (headless/ssh), fallback ke -display none
DISPLAY_OPTS=""
AUDIO_OPTS=""
if [ -n "$DISPLAY" ]; then
    # Menggunakan akselerasi 3D VirGL GPU untuk performa 60 FPS mulus
    DISPLAY_OPTS="-device virtio-gpu-gl-pci,xres=${RES_X},yres=${RES_Y} -display gtk,gl=on,zoom-to-fit=on"
    AUDIO_OPTS="-audiodev pa,id=snd0 -device intel-hda -device hda-duplex,audiodev=snd0"
else
    echo "Peringatan: Variabel DISPLAY tidak diset. Menjalankan dalam mode headless (-display none)."
    DISPLAY_OPTS="-device virtio-gpu-pci,xres=${RES_X},yres=${RES_Y} -display none"
    AUDIO_OPTS="-audiodev none,id=snd0"
fi

KERNEL_OPTS=""
if [ -f "$KERNEL_IMG" ]; then
    KERNEL_OPTS="-kernel ${KERNEL_IMG} -append \"root=/dev/vda2 rw rootwait console=tty1 console=ttyAMA0,115200 video=${RES_X}x${RES_Y}@60 quiet splash loglevel=3 plymouth.ignore-serial-consoles vt.global_cursor_default=0\""
fi

SSH_PORT="${SSH_PORT:-22220}"
if ss -tulpn | grep -q ":2222 "; then
    SSH_PORT=22220
fi

echo "==> Menjalankan QEMU aarch64..."
echo "==> Image   : $IMG_FILE"
echo "==> SSH Port: $SSH_PORT (ssh -p $SSH_PORT jws@localhost)"
echo "==> Keluar  : Tekan Ctrl+A lalu X"

eval qemu-system-aarch64 \
  -M virt \
  -cpu cortex-a53 \
  -smp 4 \
  -m 2G \
  ${KERNEL_OPTS} \
  -drive file="${IMG_FILE}",format=raw,if=virtio \
  ${DISPLAY_OPTS} \
  ${AUDIO_OPTS} \
  -serial stdio \
  -device virtio-keyboard-pci \
  -device virtio-mouse-pci \
  -rtc base=localtime \
  -netdev user,id=net0,hostfwd=tcp::${SSH_PORT}-:22 \
  -device virtio-net-pci,netdev=net0
