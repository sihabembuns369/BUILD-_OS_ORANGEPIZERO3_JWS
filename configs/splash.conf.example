# /boot/splash.conf
# Konfigurasi Splash Screen Boot Logo (Armbian / Anbernic style)
# Dapat diedit langsung dari PC melalui partisi BOOT (FAT32)

ENABLED=yes                       # yes / no
MODE=gif                          # gif (Animasi boot.gif) | image | frames
IMAGE=/boot/splash/logo.png       # Berkas logo yang ditampilkan (PNG / JPG)
FRAMES_DIR=/boot/splash/frames    # Folder urutan frame (bila MODE=frames)
GIF=/boot/splash/boot.gif         # Berkas animasi GIF (bila MODE=gif)
FPS=15                            # Kecepatan animasi (frame per detik bila MODE=gif/frames)
LOOP=yes                          # yes / no
BACKGROUND_COLOR=#000000          # Warna latar belakang layar (hex)
IMAGE_SCALE=fit                   # fit | fill | center | stretch
POSITION=center                   # center | top | bottom
TEXT=                             # Teks status di bawah logo/animasi (kosongkan untuk tampilan bersih)
TEXT_COLOR=#FFFFFF
PROGRESS_BAR=no                   # yes / no
MIN_DURATION=2                    # Durasi minimum tampil (detik)
ROTATION=0                        # 0 | 90 | 180 | 270
